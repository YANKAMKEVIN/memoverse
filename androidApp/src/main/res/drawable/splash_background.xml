<?xml version="1.0" encoding="utf-8"?>
<!-- Lancement avant Android 12 : fond crème et la pousse de l'icône, centrée sur un rond olive. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/memoverse_cream" />
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/memoverse_olive" />
        </shape>
    </item>
    <item
        android:width="168dp"
        android:height="168dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
